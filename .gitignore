# 비밀 값(API 키) — 절대 올리지 않는다
.env
.env.*
!.env.example

# 파이썬·도구 찌꺼기
__pycache__/
*.pyc
.ruff_cache/
node_modules/
.DS_Store

# 남이 만든 원본 자료(저작권) — 받는 주소는 코드·문서에 있음
근거자료/

# 실행하면 다시 생기는 큰 자료(3GB 이상)
작업/원본PDF/
작업/웹문서/
작업/캐시/
작업/임시/
작업/목록/
작업/백업_*/

# 기사 원문 사본(저작권·기사 속 인명) — 평가 세트는 기사 주소만으로 다시 받을 수 있음
작업/**/기사캐시/

# 화면 사용 기록(사용자가 넣은 문장)과 서버 로그
작업/결과/
작업/웹서버_로그.txt

# 평가 중간 백업
*.redo_bak

# 정부 설명자료 원본 파일(다시 받을 수 있음)
작업/평가_오보사례/설명자료/
기사캐시
작업/영상/
